<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#121212"
    android:padding="8dp">

    <!-- 左：音源列表与操作 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="120dp"
                android:layout_height="64dp"
                android:text="‹ 返回"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:background="#444444" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:text="音乐源"
                android:textSize="24sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:textColor="#FFD580"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPresets"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="导入预设"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#2E5E8C"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnUrl"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="远程JS"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#2E5E8C" />

            <Button
                android:id="@+id/btnFile"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:text="U盘/文件"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#444444" />

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:text="全部更新"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#444444" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="点一下设为当前音源，长按可删除。通过「远程JS」或「U盘/文件」自行导入自定义音源脚本（.js）"
            android:textColor="#888888"
            android:textSize="16sp" />

        <ListView
            android:id="@+id/lvSources"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#333333"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <!-- 右：自检与日志 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNetTest"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="网络自检"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#5A3E8C" />

            <Button
                android:id="@+id/btnJsTest"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:text="引擎自检"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#5A3E8C" />

            <Button
                android:id="@+id/btnRefreshLog"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:text="刷新日志"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#444444" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:text="清空"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#444444" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbConscrypt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="使用 Conscrypt TLS（关闭则用系统 TLS）"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/cbTrustAll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="宽松证书校验（仅诊断用，判断是否是证书问题）"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvTls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="#BBBBBB"
            android:textSize="16sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="#9AE69A"
                android:textSize="14sp"
                android:textIsSelectable="true"
                android:typeface="monospace" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
