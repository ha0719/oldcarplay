<?xml version="1.0" encoding="utf-8"?>
<!-- 车机桌面（CarPlay 样式）：1920×720 @240dpi（约 1280×480dp）
     第一列 10%：Dock（时间 / 3 个应用 / 设置 / 全部应用）
     第二列 60%：音乐组件
     第三列 30%：天气 + 导航地图 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <include layout="@layout/layout_dock" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <!-- ================= 音乐组件 60%：全屏播放页的缩小版 =================
             左：封面（垂直居中）   右（整体垂直居中）：歌词 / 歌名 / 歌手 / 进度 / 控制 -->
        <LinearLayout
            android:id="@+id/cardMusic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="60"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="16dp"
            android:tag="card">

            <com.mcool.player.home.RoundImageView
                android:id="@+id/ivCover"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:src="@drawable/noimg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 实时歌词：大字（没有歌词时显示歌名） -->
                <TextView
                    android:id="@+id/tvLyric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:minLines="2"
                    android:text="还没有播放音乐"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- 歌名 · 歌手：小字 -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="点这里进入音乐"
                    android:textColor="#99FFFFFF"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPos"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp" />

                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvDur"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:text="0:00"
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- 控制（精简版）：顺序 | 上一首 | 播放 | 下一首 | 占位，五格等宽，播放键在正中 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMode"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:background="@drawable/tile_bg"
                        android:text="循环"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:background="@drawable/tile_bg"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/prev" />

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:background="@drawable/tile_bg"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/play" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:background="@drawable/tile_bg"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/next" />

                    <!-- 右侧占位（和"顺序"等宽），让播放键在整行正中 -->
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <!-- ================= 右列 30%：天气 + 导航 ================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="30"
            android:orientation="vertical">

            <!-- 天气卡片 -->
            <LinearLayout
                android:id="@+id/cardWeather"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="18dp"
                android:tag="card">

                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="北京"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivWeather"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="--°"
                        android:textColor="#FFFFFF"
                        android:textSize="56sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/tvRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:textColor="#CCCCCC"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="10dp" />

            <!-- 导航卡片（未导航显示 2D 巡航小地图或快捷方式，高德导航中自动切为 TBT 实时诱导卡片） -->
            <FrameLayout
                android:id="@+id/cardNav"
                android:tag="card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/card_bg">

                <!-- 态 0：2D 栅格瓦片巡航小地图 -->
                <FrameLayout
                    android:id="@+id/navMapGroup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.mcool.player.home.MiniMapView
                        android:id="@+id/miniMapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvMapStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|left"
                        android:layout_marginLeft="12dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/nav_pill_bg"
                        android:paddingLeft="10dp"
                        android:paddingTop="4dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="4dp"
                        android:singleLine="true"
                        android:text="等待 GPS 定位…"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMapNavHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|right"
                        android:layout_marginRight="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/nav_pill_bg"
                        android:paddingLeft="10dp"
                        android:paddingTop="4dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="4dp"
                        android:singleLine="true"
                        android:text="点击打开导航"
                        android:textColor="#E0E0E0"
                        android:textSize="13sp" />
                </FrameLayout>

                <!-- 态 1：导航快捷入口（关闭小地图时显示） -->
                <LinearLayout
                    android:id="@+id/navShortcutGroup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivNav"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="导航"
                            android:textColor="#FFFFFF"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNavSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="长按选择导航应用"
                            android:textColor="#CCCCCC"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 态 2：高德导航实时 TBT 引导卡片 -->
                <LinearLayout
                    android:id="@+id/navTbtGroup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.mcool.player.home.NavTurnIconView
                            android:id="@+id/ivNavTurn"
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:background="@drawable/nav_badge_bg"
                            android:padding="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="18dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNavSegDis"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text="--"
                                android:textColor="#FFFFFF"
                                android:textSize="36sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvNavNextRoad"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="高德导航中"
                                android:textColor="#D9F5E5"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="8dp"
                        android:background="#26FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNavRemain"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="点击返回高德导航"
                            android:textColor="#CCCCCC"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvNavLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:background="@drawable/nav_limit_bg"
                            android:paddingLeft="8dp"
                            android:paddingTop="2dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="2dp"
                            android:singleLine="true"
                            android:text="限速 60"
                            android:textColor="#FF9E9E"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
