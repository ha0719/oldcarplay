<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏播放页（CarPlay 正在播放样式）：左侧 Dock 保留，右侧整块播放卡片；左上角圆形返回按钮 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <include layout="@layout/layout_dock" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:id="@+id/cardPlayer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="90"
            android:background="@drawable/card_bg"
            android:tag="card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="20dp"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:paddingTop="20dp">

                <!-- 左：封面（上方留出返回按钮的位置，避免重叠） -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingBottom="8dp"
                    android:paddingTop="56dp">

                    <com.mcool.player.home.RoundImageView
                        android:id="@+id/ivCover"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/noimg" />
                </FrameLayout>

                <!-- 右：歌词（一次一句）/ 歌名 / 歌手 / 进度 / 控制 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="28dp"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLyric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:minLines="2"
                        android:text="还没有播放音乐"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tvArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textColor="#99FFFFFF"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPos"
                            android:layout_width="56dp"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="#B3FFFFFF"
                            android:textSize="16sp" />

                        <SeekBar
                            android:id="@+id/seekBar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvDur"
                            android:layout_width="56dp"
                            android:layout_height="wrap_content"
                            android:gravity="right"
                            android:text="0:00"
                            android:textColor="#B3FFFFFF"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textColor="#80FFFFFF"
                        android:textSize="15sp" />

                    <!-- 控制：顺序 | 上一首 | 播放 | 下一首 | 收藏 | 切换歌单 | 搜索 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMode"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:background="@drawable/tile_bg"
                            android:text="循环"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />

                        <ImageButton
                            android:id="@+id/btnPrev"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:background="@drawable/tile_bg"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/prev" />

                        <ImageButton
                            android:id="@+id/btnPlay"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:background="@drawable/tile_bg"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/play" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:background="@drawable/tile_bg"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/next" />

                        <Button
                            android:id="@+id/btnLove"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:background="@drawable/tile_bg"
                            android:text="♡"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp" />

                        <Button
                            android:id="@+id/btnCycle"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1.3"
                            android:background="@drawable/tile_bg"
                            android:text="切换歌单"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />

                        <Button
                            android:id="@+id/btnSearch"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:background="@drawable/tile_bg"
                            android:text="搜索"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 左上角圆形返回按钮：只有箭头 -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="top|left"
                android:layout_margin="8dp"
                android:background="@android:color/transparent"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back_round" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
